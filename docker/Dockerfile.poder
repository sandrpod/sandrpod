# Copyright 2026 SandrPod Contributors
# Poder 镜像 - Worker 节点服务 (Proxy + Agent)

# 构建阶段跑在 BUILDPLATFORM（原生架构）上做交叉编译，
# 避免 buildx 多架构时整个 Go 编译落在 QEMU 仿真里（慢一个数量级）。
#
# BUILDPLATFORM 只在 buildx 下自动注入。没有 buildx 的 docker（默认不带）会让它
# 展开成空串，`FROM --platform=` 直接报 `failed to parse platform`——整条构建失败，
# 和代码无关。给一个默认值即可两边都能用；arm64 机器没有 buildx 时传
# `--build-arg BUILDPLATFORM=linux/arm64`。
ARG BUILDPLATFORM
# FROM 引用的 ARG 必须在第一个 FROM 之前（全局作用域），否则展开为空。
ARG GO_IMAGE=golang:1.27-alpine
ARG RUNTIME_IMAGE=alpine:3.24
FROM --platform=${BUILDPLATFORM:-linux/amd64} ${GO_IMAGE} AS builder
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY} GOSUMDB=off

WORKDIR /app

# 安装依赖
RUN apk add --no-cache git

# 复制源码 (从父目录，因为 go.mod 在那里)
COPY . .

# 构建（VERSION 由 release workflow 以 build-arg 注入）
ARG TARGETOS TARGETARCH
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOTOOLCHAIN=auto \
    go build -ldflags="-s -w -X main.version=${VERSION}" -o /poder ./cmd/poder

# 最终镜像
FROM ${RUNTIME_IMAGE}

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# 复制二进制
COPY --from=builder /poder /app/poder

# 注意: 运行时需要挂载 /var/run/docker.sock

ENTRYPOINT ["/app/poder"]