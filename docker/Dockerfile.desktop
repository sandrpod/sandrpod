# 桌面沙箱镜像：Ubuntu 22.04（jammy）+ XFCE + KasmVNC + 浏览器 + CJK 字体
# toolbox 从源码构建进镜像（执行/文件/MCP 全能力不变），桌面栈 apt 安装。
#
# KasmVNC deb 预先下载到 docker/（arm64 + amd64 各一），构建不依赖运行时网络。
#
# 顺序很关键：先装 deb（此时 /etc/kasmvnc 还没有我们的 kasmvnc.yaml，不会触发
# conffile 冲突提示卡死构建），之后再写我们的精简配置覆盖它。
#
# 构建（amd64，HK/生产）： docker build -f docker/Dockerfile.desktop -t sandrpod-desktop:v1 .
# 构建（arm64，Mac）：     docker build --build-arg TARGETARCH=arm64 -f docker/Dockerfile.desktop -t sandrpod-desktop:v1 .
# 运行： docker run -p 6901:6901 sandrpod-desktop:v1 → 浏览器 https://localhost:6901
# （沙箱里端口不映射，经 toolbox /proxy/6901 + preview URL 暴露）
ARG GO_IMAGE=golang:1.27-bookworm
# FROM 引用的 ARG 必须是全局作用域（在第一个 FROM 之前声明）
ARG RUNTIME_IMAGE=ubuntu:22.04
FROM ${GO_IMAGE} AS builder
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY} GOSUMDB=off
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -o /toolbox ./cmd/toolbox

FROM ${RUNTIME_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/root
# TARGETARCH 是 BuildKit 预置变量（构建机架构）；必须在使用它的 stage 内重新声明
ARG TARGETARCH=amd64
# 桌面分辨率：1280x800 标准、1024x640 省流量（构建时用 --build-arg DESKTOP_GEOMETRY=1024x640）
ARG DESKTOP_GEOMETRY=1280x800

# 阿里云镜像源：CI 主机与国内网络访问 archive.ubuntu.com 很慢甚至超时。
# 官方源在海外部署仍可用，用 build-arg APT_MIRROR=archive.ubuntu.com 覆盖回来。
ARG APT_MIRROR=mirrors.aliyun.com
# plain = keep XFCE's own look (its mouse wallpaper, bottom panel, Adwaita). It is
# the look some people prefer — and it is what the image renders anyway when the
# Yaru packages are unavailable — so make it a choice rather than a fallback.
ARG DESKTOP_THEME=yaru
RUN sed -i "s|//archive.ubuntu.com|//${APT_MIRROR}|g; s|//security.ubuntu.com|//${APT_MIRROR}|g" /etc/apt/sources.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      wget ca-certificates curl perl gnupg \
      xfce4 xfce4-terminal xfce4-panel xfce4-whiskermenu-plugin dbus-x11 x11-xserver-utils xdotool scrot \
      $(if [ "$DESKTOP_THEME" = "plain" ]; then echo ""; elif [ "$DESKTOP_THEME" = "dock" ]; then echo adwaita-icon-theme papirus-icon-theme ubuntu-wallpapers plank; else echo yaru-theme-gtk yaru-theme-icon yaru-theme-sound fonts-ubuntu ubuntu-wallpapers; fi) \
      fonts-noto-cjk fonts-noto-color-emoji language-pack-zh-hans \
      libswitch-perl libyaml-tiny-perl libhash-merge-simple-perl \
      libscalar-list-utils-perl liblist-moreutils-perl libtry-tiny-perl \
      libdatetime-perl libdatetime-timezone-perl \
      libgl1 libpixman-1-0 libxfont2 libxcursor1 libxtst6 libxrandr2 \
      xauth x11-xkb-utils xkb-data procps ssl-cert libunwind8 ffmpeg \
 && rm -rf /var/lib/apt/lists/*

# KasmVNC 用 dlopen("libavformat.so") 打开 ffmpeg：jammy 只装带版本号的 .so.58，
# 没有无版本号的名字，所以 H.264 一直不可用（日志里 WEBP benchmark 胜出）。
# 补一组 unversioned 符号链接，H.264 才会真正启用。
RUN for lib in avformat avcodec avutil swscale swresample; do       f=$(ls /usr/lib/x86_64-linux-gnu/lib${lib}.so.* 2>/dev/null | head -1);       [ -n "$f" ] && ln -sf "$f" /usr/lib/x86_64-linux-gnu/lib${lib}.so;     done; ldconfig

# 浏览器：amd64 装 Google Chrome（官方 deb），arm64 没有官方构建，回退 epiphany。
# Chrome 以 root 跑必须 --no-sandbox（容器内本就是隔离边界），包一层 wrapper 免得每次带参数。
RUN if [ "${TARGETARCH:-amd64}" = "amd64" ]; then \
      wget -q -O /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
      && apt-get update && apt-get install -y --no-install-recommends /tmp/chrome.deb \
      && rm -f /tmp/chrome.deb \
      && apt-get install -y --no-install-recommends libunwind8 \
      && rm -rf /var/lib/apt/lists/* \
      && mv /usr/bin/google-chrome-stable /usr/bin/google-chrome-real \
      && printf '#!/bin/sh\nexec /usr/bin/google-chrome-real --test-type --no-sandbox --disable-dev-shm-usage --disable-gpu --no-first-run --no-default-browser-check --disable-session-crashed-bubble --user-data-dir=/root/.chrome-profile --remote-debugging-port=9222 --remote-debugging-address=0.0.0.0 --remote-allow-origins=* "$@"\n' > /usr/bin/google-chrome \
      && chmod +x /usr/bin/google-chrome; \
    else \
      apt-get update && apt-get install -y --no-install-recommends epiphany-browser \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# 1) KasmVNC deb。jammy 的 arm64 包把 Depends 硬编码成了 :amd64（上游打包瑕疵），
#    所以强装；perl/x11 依赖上一条已按本机架构补齐。
COPY docker/kasmvncserver_jammy_${TARGETARCH:-amd64}.deb /tmp/kasmvnc.deb
RUN dpkg --force-depends -i /tmp/kasmvnc.deb && rm -f /tmp/kasmvnc.deb

# 2) 覆盖为沙箱的精简配置：web 端口固定 6901、不强制自签 HTTPS（外层 Caddy 已有 TLS）。
#    连接口令烘焙在 .kasmpasswd（默认 sandrbox，改法：容器内 vncpasswd -u root -w）。
RUN mkdir -p /root/.vnc /workspace \
 && printf 'network:\n  protocol: http\n  websocket_port: 6901\n  ssl:\n    require_ssl: false\nserver:\n  advanced:\n    kasm_password_file: /root/.kasmpasswd\ncommand_line:\n  prompt: false\n' > /etc/kasmvnc/kasmvnc.yaml \
 && printf 'sandrbox' > /root/.kasmpasswd \
 && chmod 600 /root/.kasmpasswd \
 && THEME_NAME=$(if [ "$DESKTOP_THEME" = "plain" ]; then echo Adwaita; elif [ "$DESKTOP_THEME" = "dock" ]; then echo Adwaita-dark; else echo Yaru; fi) \
 && WALLPAPER=$(if [ "$DESKTOP_THEME" = "plain" ]; then echo /usr/share/backgrounds/xfce/xfce-mouse-1.png; elif [ "$DESKTOP_THEME" = "dock" ]; then echo /usr/share/backgrounds/Jammy-Jellyfish_WP_4096x2304_Grey.png; else echo /usr/share/backgrounds/Blue_flower_by_Elena_Stravoravdi.jpg; fi) \
 && ICONS=$(if [ "$DESKTOP_THEME" = "dock" ]; then echo Papirus-Dark; else echo Papirus; fi) \
 && mkdir -p /root/.config/xfce4/xfconf/xfce-perchannel-xml /root/Desktop \
 && printf '<?xml version="1.0" encoding="UTF-8"?>\n<channel name="xsettings" version="1.0">\n  <property name="Net" type="empty">\n    <property name="ThemeName" type="string" value="${THEME_NAME}"/>\n    <property name="IconThemeName" type="string" value="${ICONS}"/>\n  </property>\n  <property name="Xft" type="empty">\n    <property name="DPI" type="int" value="96"/>\n    <property name="Antialias" type="int" value="1"/>\n    <property name="HintStyle" type="string" value="hintslight"/>\n    <property name="RGBA" type="string" value="rgb"/>\n  </property>\n</channel>\n' > /root/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml \
 && printf '<?xml version="1.0" encoding="UTF-8"?>\n<channel name="xfwm4" version="1.0">\n  <property name="general" type="empty">\n    <property name="theme" type="string" value="${THEME_NAME}"/>\n  </property>\n</channel>\n' > /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml \
 && printf '[Desktop Entry]\nType=Application\nName=Google Chrome\nExec=/usr/bin/google-chrome\nIcon=google-chrome\nTerminal=false\n' > /root/Desktop/google-chrome.desktop \
 && chmod +x /root/Desktop/google-chrome.desktop \
 && printf '<?xml version="1.0" encoding="UTF-8"?>\n<channel name="xfce4-desktop" version="1.0">\n  <property name="backdrop" type="empty">\n    <property name="screen0" type="empty">\n      <property name="monitor0" type="empty">\n        <property name="workspace0" type="empty">\n          <property name="last-image" type="string" value="${WALLPAPER}"/>          <property name="image-path" type="string" value="${WALLPAPER}"/>\n          <property name="image-style" type="int" value="5"/>\n        </property>\n      </property>\n    </property>\n  </property>\n</channel>\n' > /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml \
 && sed -i "s|\${THEME_NAME}|${THEME_NAME}|g; s|\${ICONS}|${ICONS}|g" /root/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml \
 && sed -i "s|\${WALLPAPER}|${WALLPAPER}|g" /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml \
 && touch /root/.vnc/.de-was-selected \
 && printf '#!/bin/sh\nexport HOME=/root\nexec startxfce4\n' > /root/.vnc/xstartup \
 && chmod +x /root/.vnc/xstartup

# 3) toolbox（执行/文件/MCP）+ 启动脚本
COPY --from=builder /toolbox /app/toolbox
COPY docker/desktop-start.sh /app/desktop-start.sh
RUN chmod +x /app/desktop-start.sh

# 桌面分辨率（启动脚本读取；两个镜像变体只有这个值不同）
RUN printf '%s' "${DESKTOP_GEOMETRY}" > /etc/sandrpod-desktop-geometry

# 桌面端口（容器内）；toolbox 仍在 8080
EXPOSE 6901 5901 8080

ENTRYPOINT ["/app/desktop-start.sh"]

# Dock 布局写进 xfce4-panel.xml，而不是运行时用 xfconf-query：容器里没有会话总线，
# xfconf 写入会静默失败（之前"改了没效果"就是这么来的）。XFCE 启动时直接读它。
# 文件从构建上下文 COPY 进来（legacy builder 不支持 RUN 里的 heredoc），非 dock 变体
# 只是多一个没人读的 /tmp 文件。
COPY docker/desktop-panel.xml /tmp/desktop-panel.xml
RUN if [ "$DESKTOP_THEME" = "dock" ]; then \
      mkdir -p /root/.config/xfce4/xfconf/xfce-perchannel-xml \
      && cp /tmp/desktop-panel.xml /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml \
      && echo "/usr/share/backgrounds/Jammy-Jellyfish_WP_4096x2304_Grey.png" > /etc/sandrpod-desktop-wallpaper; fi
# plank 的 dock 配置（只有 dock 变体需要）。settings 是 keyfile，launchers 目录里
# 每个 *.dockitem 是一个入口。位置/居中/透明都由 plank 自己管，比手工调
# xfce4-panel 的 position 稳得多。
RUN if [ "$DESKTOP_THEME" = "dock" ]; then \
      mkdir -p /root/.config/plank/dock1/launchers \
      && printf '[PlankDockPreferences]\nCurrentDock=%s\n\n[Dock1]\nPosition=3\nAlignment=3\nIconSize=48\nZoomEnabled=true\nZoomPercent=125\nTheme=Transparent\nHideMode=0\nLockItems=false\n' 1 > /root/.config/plank/dock1/settings \
      && printf '[{"Launcher":"/usr/share/applications/google-chrome.desktop","Name":"Chrome","DockItemType":"Application"}]' > /root/.config/plank/dock1/launchers/google-chrome.dockitem \
      && printf '[{"Launcher":"/usr/share/applications/xfce4-terminal.desktop","Name":"Terminal","DockItemType":"Application"}]' > /root/.config/plank/dock1/launchers/xfce4-terminal.dockitem \
      && printf '[{"Launcher":"/usr/share/applications/thunar.desktop","Name":"Files","DockItemType":"Application"}]' > /root/.config/plank/dock1/launchers/thunar.dockitem; fi
