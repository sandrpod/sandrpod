# sandrpod-egress-proxy: the per-pod egress proxy a container sandbox reaches.
#
# Published by the release workflow alongside the other images — a workbook that
# cannot pull it cannot create a sandbox with an egress policy at all, which is
# why it is in that matrix rather than built by hand.
#
# The build stage runs on BUILDPLATFORM and cross-compiles for TARGETARCH, so a
# multi-arch push does not spend its time under QEMU.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
WORKDIR /src
COPY . .
ARG TARGETOS TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOTOOLCHAIN=auto \
    go build -ldflags="-s -w" -o /egress-proxy ./cmd/egress-proxy

FROM alpine:3.20
COPY --from=build /egress-proxy /usr/local/bin/egress-proxy
# Runs unprivileged: the proxy only binds loopback/ports > 1024 and dials out.
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/egress-proxy"]
