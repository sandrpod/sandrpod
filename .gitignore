/sandrpod-tray.exe
/bin/

# Cross-compiled artifacts
*-linux
*-darwin
*-windows

# Go build cache
# `.gocache/` is what `GOCACHE=$PWD/.gocache go test ./...` leaves behind when
# the default cache dir under $HOME is not writable (sandboxed CI, EDR'd
# laptops). It is 100 MB+ of compiled artifacts, never source.
.gocache/
*.test
*.out
coverage.out
coverage.html

# Go workspace
go.work
go.work.sum

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
server.log

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment
.env
.env.local
.env.*.local

# Secrets / credentials
*.pem
*.key
*.crt
credentials.json

# Runtime data (SQLite DB, etc.)
/data/

# Claude Code local settings (contains device hostname, IP, private paths)
.claude/settings.local.json
.claude/worktrees/

# Local media / marketing assets (video scripts, recordings, etc.)
/media/

# Internal working notes — competitor reads, pricing snapshots, draft strategy.
# Kept on the machine, never published: the repo is public and these documents
# quote other companies' pages and price lists.
devdoc/

# The commercial build's prototype — a separate Go module that imports this one
# (see cloud/README.md). Untracked for the same reason devdoc/ is: it is not
# part of the open-source product.
/cloud/
